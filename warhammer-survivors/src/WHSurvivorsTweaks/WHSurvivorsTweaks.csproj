<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>WHSurvivorsTweaks</AssemblyName>
    <RootNamespace>WHSurvivorsTweaks</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.3.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Folder of the game install with MelonLoader already run once (generates Il2CppAssemblies). -->
    <GameDir Condition="'$(GameDir)' == ''">D:\Steam\steamapps\common\Warhammer Survivors</GameDir>
    <MLDir>$(GameDir)\MelonLoader</MLDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(MLDir)\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(MLDir)\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(MLDir)\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <!-- All generated interop assemblies: game types inherit from types spread across many of them. -->
    <Reference Include="$(MLDir)\Il2CppAssemblies\*.dll" Private="false" />
  </ItemGroup>

</Project>
